rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Suivi temps réel des commandes
    match /live_orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Présence en direct des boutiques (Live Marketplace)
    match /live_presence/{shopId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Notifications directes pour vendeurs
    match /vendor_notifications/{vendorId}/notifications/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == vendorId;
      allow create: if true; // Permettre aux clients d'envoyer une notification de commande
    }
  }
}
